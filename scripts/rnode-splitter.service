# Serial splitter — one RNode, two jobs. Owns the real Jonesey port, presents
# a virtual port at /tmp/rnode-jonesey for rnsd (LoRa stays online 100%), and
# skims GPS + signal stats to /dev/shm (tmpfs) for the tool — the medic's
# position lives in RAM only, never on the SD card (operator, 2026-08-07).
# Installed by scripts/setup_boot.sh, which fills in __RNODE_BY_ID__ with the
# by-id path of THIS medic's own radio. It is a placeholder on purpose: the
# path contains the board's MAC, which is a permanent fingerprint of one
# specific device — and a cloned medic carries different hardware, so a
# hardcoded serial would be wrong for it anyway.
# Ordered before rnsd via its drop-in.
[Unit]
Description=RNode serial splitter (LoRa + GPS on one port)
After=dev-ttyACM0.device

[Service]
Type=simple
User=nodemedic
WorkingDirectory=/home/nodemedic/reticulum-tool
ExecStart=/usr/bin/python3 -c "from monitor.serial_splitter import run; run(real_port='__RNODE_BY_ID__', symlink='/tmp/rnode-jonesey', state_file='/dev/shm/nodemedic-gps.json')"
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
