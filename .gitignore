# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Test / tooling
.pytest_cache/
.coverage
htmlcov/

# Kivy / OS
.kivy/
*.log
.DS_Store

# Local, carried-in-the-field binaries (kept out of git; placed on the device)
assets/firmware/*
!assets/firmware/.gitkeep
assets/packages/*
!assets/packages/.gitkeep
assets/maps/*
!assets/maps/.gitkeep
assets/apps/*
!assets/apps/.gitkeep
typescript

# Carried display fonts (e.g. Noto Sans JP for Japanese) — placed/fetched on the
# device, kept out of git like the other carried binaries.
assets/fonts/*
!assets/fonts/.gitkeep

# Agent scratch: worktrees + local settings. Never belongs in history —
# a `git add -A` once swept an unreviewed agent worktree into a commit.
.claude/

# Rendered animation preview frames — regenerate with scripts/preview_*.py
docs/previews/
